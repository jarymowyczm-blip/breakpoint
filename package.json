{
  "name": "breachpoint",
  "private": true,
  "version": "1.0.0",
  "description": "BREACHPOINT - browser FPS with authoritative multiplayer, bots, campaign and practice modes",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js",
    "validate:levels": "node tools/validate-levels.js",
    "test": "node tools/validate-levels.js && node tools/test-sim.js"
  },
  "keywords": [
    "fps",
    "three.js",
    "webgl",
    "multiplayer",
    "websocket"
  ],
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
